# Copy to .env for `npm run dev`. In production, set these in your platform's environment.

# Which provider this worker runs: byo | eideasy
PROVIDER=byo

# The URL SignatureAPI calls this worker at, exactly as entered in the dashboard (it is the JWT `aud`).
PUBLIC_URL=http://localhost:8080
PORT=8080

# Required. The connection tokens of the SignatureAPI accounts this worker serves, comma-separated.
# Dashboard > Settings > Qualified Signatures shows each mode's token (test and live differ).
SIGNATUREAPI_CONNECTION_TOKENS=swpct_replace_me

# Where the worker keeps its state (one SQLite file). Default ./data/worker.sqlite; the Docker image uses /data.
# DATABASE_PATH=./data/worker.sqlite

# Defaults point at SignatureAPI production; change only for local testing.
# PLATFORM_ISSUER=https://api.signatureapi.com
# PLATFORM_JWKS_URL=https://api.signatureapi.com/v1/signing-protocol/jwks

# --- PROVIDER=byo: a P-256 key and its certificate chain (leaf first), as PEM text or files.
BYO_CERTIFICATES_PEM_FILE=./certs/chain.pem
BYO_PRIVATE_KEY_PEM_FILE=./certs/key.pem
# BYO_CERTIFICATES_PEM="-----BEGIN CERTIFICATE-----\n..."
# BYO_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."

# --- PROVIDER=eideasy: API credentials from id.eideasy.com (sandbox: test.eideasy.com).
# EIDEASY_CLIENT_ID=
# EIDEASY_SECRET=
# EIDEASY_BASE_URL=https://test.eideasy.com
